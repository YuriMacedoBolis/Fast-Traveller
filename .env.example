# Copie este arquivo para .env e preencha os valores.
# O .env NUNCA deve ser versionado (ja esta no .gitignore).

# --- Django ---
# Gere uma chave com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Banco de dados ---
# Em desenvolvimento, deixe vazio para usar SQLite local.
# Em producao (Supabase), use o POOLER em session mode, porta 5432:
# postgresql://postgres.<PROJECT-REF>:<SENHA>@aws-<N>-<REGIAO>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# --- API externa (Geoapify) ---
# Chave gratuita em https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=
GEOAPIFY_TIMEOUT=5
GEOAPIFY_CACHE_TTL=86400
GEOAPIFY_RAIO_PADRAO_M=5000

# --- Superusuario criado automaticamente no deploy ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
